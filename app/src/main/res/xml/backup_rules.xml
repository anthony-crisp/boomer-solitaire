<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device. The app has no network permission, and this
     stops the OS backing her save and statistics up to Google Drive on its
     own initiative. -->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
